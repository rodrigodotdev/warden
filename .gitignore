# Rust
/target/
**/*.rs.bk

# Coverage
/coverage/
*.profraw
*.profdata

# Secrets and local environment—never commit a DSN
.env
.env.*
!.env.example
/secrets/

# Agent session artefacts — transcripts can quote configuration and DSNs
/codex-session-*.md
/*-local-command-caveat*.txt
/.codex/sessions/

# Editors
.idea/
.vscode/
*.swp

# Operating systems
.DS_Store
Thumbs.db

# npm packaging. Reproducing the `npm` job of release.yml locally leaves all three
# behind: `dist/` holds the downloaded release archives and `unpacked/` their contents,
# both inputs, and `packages/` is the assembled output that job publishes.
/dist/
/unpacked/
/packages/
